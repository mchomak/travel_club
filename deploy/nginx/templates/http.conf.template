server {
    listen 80;
    server_name @SERVER_NAME@;

    location ^~ /.well-known/acme-challenge/ {
        root @ACME_WEBROOT@;
        default_type text/plain;
        autoindex off;
        limit_except GET { deny all; }
        try_files $uri =404;
    }

    location / {
        return 308 https://@SERVER_NAME@:@HTTPS_PORT@$request_uri;
    }
}
