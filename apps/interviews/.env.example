# Required only by server-side auth and same-origin API rewrites.
BACKEND_URL=http://127.0.0.1:8000

# Used by the shared-origin gateway to namespace Next static chunks.
# The app rewrites this path locally when launched on its own port.
NEXT_ASSET_PREFIX=/_app/interviews

# Optional when running standalone. Leave empty behind the shared-origin gateway.
NEXT_PUBLIC_CONSTRUCTOR_URL=http://localhost:3101
