# Website has no required environment variables.
# For `npm run dev` outside Compose, send leads to the loopback-published API.
WEBSITE_LEADS_API_URL=http://127.0.0.1:8001
# Enable only after approving and publishing the privacy and personal-data documents.
# Local synthetic tests can explicitly enable the form in an isolated environment.
WEBSITE_LEAD_FORM_ENABLED=false
# For an optional local proxy for other APIs, set BACKEND_URL to FastAPI.
# Prepared integration only. Do not enable until the privacy and Webvisor risks
# in docs/website/LEADS_SYSTEM.md are resolved; this value is baked in at build.
NEXT_PUBLIC_YANDEX_METRIKA_ENABLED=false
