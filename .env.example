# Generate a local password with: python scripts/init_env.py
# This placeholder is not a credential; never use it for a running database.
POSTGRES_PASSWORD=replace-locally
POSTGRES_DB=travel_club
POSTGRES_USER=travel_club
POSTGRES_HOST=localhost
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:3000
RESEARCH_ORIGIN=
# Exact local origins accepted by backend CSRF checks; Compose also adds its configured gateway port.
ADDITIONAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3102,http://127.0.0.1:3102
# The shared local gateway defaults to 3000; use 3300 if that port is already occupied.
GATEWAY_PORT=3000
# Comma-separated CIDRs of trusted reverse proxies immediately in front of
# the gateway. Leave blank unless the source range is known and controlled.
GATEWAY_TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=false
# Optional; enter actual keys only in the local .env, never commit them.
GEOAPIFY_API_KEY=
GEOAPIFY_MAPS_API_KEY=
# Website leads are stored in an isolated database. Run `python scripts/init_env.py`
# to create the separate ignored `.env.website` file with independent passwords.
# Telegram delivery is disabled until the team configures both values.
# TELEGRAM_LEADS_CHAT_ID accepts one chat ID or a comma-separated recipient list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
# Exact browser origins allowed to submit Website leads. Adjust the gateway port
# if `GATEWAY_PORT` is changed; add the production Website origin in deployment.
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300,http://localhost:3100,http://127.0.0.1:3100
# Exact source CIDR(s) of the gateway process as seen by Website API.
# Leave blank locally to use the socket peer for rate limiting.
WEBSITE_TRUSTED_PROXY_CIDRS=
