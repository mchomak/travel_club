# Generate a local password with: python scripts/init_env.py
# This placeholder is not a credential; never use it for a running database.
POSTGRES_PASSWORD=replace-locally
POSTGRES_DB=travel_club
POSTGRES_USER=travel_club
POSTGRES_HOST=localhost
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:3000
RESEARCH_ORIGIN=
COOKIE_SECURE=false
# Optional; enter actual keys only in the local .env, never commit them.
GEOAPIFY_API_KEY=
GEOAPIFY_MAPS_API_KEY=
