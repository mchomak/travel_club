# Dedicated Website leads PostgreSQL cluster bootstrap credentials.
# `scripts/init_env.py` replaces these placeholders in ignored `.env.website`.
POSTGRES_USER=website_cluster_admin
POSTGRES_PASSWORD=replace-website-postgres-admin-locally
POSTGRES_DB=postgres
WEBSITE_DATABASE_NAME=travel_club_website
WEBSITE_APP_DB_PASSWORD=replace-website-app-locally
WEBSITE_MIGRATOR_DB_PASSWORD=replace-website-migrator-locally

# The API and worker receive only the runtime URL; the migration service receives
# only the migration URL. Passwords are URL-safe tokens generated locally.
WEBSITE_DATABASE_URL=postgresql+psycopg://travel_club_website_app:replace-website-app-locally@website-postgres:5432/travel_club_website
WEBSITE_MIGRATION_DATABASE_URL=postgresql+psycopg://travel_club_website_migrator:replace-website-migrator-locally@website-postgres:5432/travel_club_website
WEBSITE_RECEIPT_SECRET=replace-website-receipt-secret-locally
WEBSITE_RATE_LIMIT_SECRET=replace-website-rate-secret-locally
