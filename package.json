{
  "name": "travel-club-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:website": "npm --prefix apps/website run dev",
    "dev:constructor": "npm --prefix apps/trip-constructor run dev",
    "dev:interviews": "npm --prefix apps/interviews run dev",
    "dev:gateway": "node gateway/server.mjs",
    "start:website": "npm --prefix apps/website run start",
    "start:constructor": "npm --prefix apps/trip-constructor run start",
    "start:interviews": "npm --prefix apps/interviews run start",
    "build:website": "npm --prefix apps/website run build",
    "build:constructor": "npm --prefix apps/trip-constructor run build",
    "build:interviews": "npm --prefix apps/interviews run build",
    "build:all": "npm run build:website && npm run build:constructor && npm run build:interviews",
    "lint:website": "npm --prefix apps/website run lint",
    "lint:constructor": "npm --prefix apps/trip-constructor run lint",
    "lint:interviews": "npm --prefix apps/interviews run lint",
    "lint:all": "npm run lint:website && npm run lint:constructor && npm run lint:interviews",
    "typecheck:website": "npm --prefix apps/website run typecheck",
    "typecheck:constructor": "npm --prefix apps/trip-constructor run typecheck",
    "typecheck:interviews": "npm --prefix apps/interviews run typecheck",
    "typecheck:all": "npm run typecheck:website && npm run typecheck:constructor && npm run typecheck:interviews",
    "test:gateway": "node --test gateway/server.test.mjs",
    "test:website": "npm --prefix apps/website run test",
    "test:constructor": "npm --prefix apps/trip-constructor run test",
    "test:interviews": "npm --prefix apps/interviews run test",
    "test:all": "npm run test:gateway && npm run test:website && npm run test:constructor && npm run test:interviews"
  }
}
